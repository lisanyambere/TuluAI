{
  "name": "@tulu/agent-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "pnpm --filter @tulu/shared build",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "prebuild": "pnpm --filter @tulu/shared build",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @tulu/shared build",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@tulu/shared": "workspace:*",
    "openai": "^7.15.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
