# Copy to .env and replace this placeholder. Never commit the real key.
OPENAI_API_KEY=replace-with-your-project-service-account-key

# These are intentionally constrained to the models selected for the MVP.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_BACKEND_MODEL=gpt-5.6-terra

HOST=127.0.0.1
PORT=8787
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Session creation is chargeable, so keep this endpoint tightly limited.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=6

# Leave false unless this service is behind a proxy you control.
TRUST_PROXY=false
