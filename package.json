{
  "name": "tulu-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm run dev:stack",
    "dev:stack": "pnpm --parallel --filter @tulu/agent-api --filter @tulu/mobile --filter @tulu/main-dash dev",
    "dev:agent": "pnpm --filter @tulu/agent-api dev",
    "dev:mobile": "pnpm --filter @tulu/mobile dev",
    "dev:dash": "pnpm --filter @tulu/main-dash dev",
    "build": "pnpm -r --if-present run build",
    "build:agent": "pnpm --filter @tulu/agent-api build",
    "build:mobile": "pnpm --filter @tulu/mobile build",
    "build:dash": "pnpm --filter @tulu/main-dash build",
    "preview:mobile": "pnpm --filter @tulu/mobile preview",
    "test": "pnpm -r --if-present run test",
    "test:agent": "pnpm --filter @tulu/agent-api test",
    "typecheck": "pnpm -r --if-present run typecheck"
  }
}
